<Window x:Class="ParcaBul.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ParcaBul" Icon="Assets/ParcaBul.ico" Width="630" Height="695" MinWidth="475" MinHeight="510"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0E1312" Foreground="#EFF5EF" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#ADBBB4" />
        <SolidColorBrush x:Key="Accent" Color="#CBFA86" />
        <SolidColorBrush x:Key="Line" Color="#293932" />
        <SolidColorBrush x:Key="Panel" Color="#151E1A" />

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#22312A" />
            <Setter Property="Foreground" Value="#EFF5EF" />
            <Setter Property="BorderBrush" Value="#35483E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.83" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.67" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#13220F" />
            <Setter Property="BorderBrush" Value="#D5FFA1" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B3A32" />
                    <Setter Property="Foreground" Value="#EFF5EF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3C4A42" />
            <Setter Property="Background" Value="#202B25" />
            <Setter Property="TextElement.FontFamily" Value="Consolas" />
            <Setter Property="TextElement.Foreground" Value="#D2DDD6" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="49" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#293931" BorderBrush="#4A5C51" BorderThickness="1" CornerRadius="14">
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Margin="4,0" HorizontalAlignment="Left" Fill="#B4C4B9" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#1D3214" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.83" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#314139" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#26332C" BorderThickness="0,0,0,1" Background="#121916">
                <DockPanel Margin="20,0,10,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#24382A" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                            <Path Data="M 1,8 H 4 L 7,2 L 11,14 L 14,8 H 17" Stroke="{StaticResource Accent}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ParcaBul" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="MinimizeClick" Style="{StaticResource ChromeButton}" ToolTip="Minimize"
                                AutomationProperties.Name="Minimize">
                            <Path Data="M 1,1 H 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button Click="CloseClick" Style="{StaticResource ChromeButton}" ToolTip="Close" AutomationProperties.Name="Close">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="MainContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,22,24,24" MaxWidth="630">
                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource Line}" Padding="22,16,22,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                <GradientStop Color="#1C2B23" Offset="0" />
                                <GradientStop Color="#141D19" Offset="0.62" />
                                <GradientStop Color="#131B18" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Border HorizontalAlignment="Center" CornerRadius="14" Padding="9,4,10,5" BorderThickness="1"
                                    BorderBrush="#375043" Background="#1E3027" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#9DAFA4" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock x:Name="AudioIndicator" Text="System audio" FontSize="12" FontWeight="SemiBold" Foreground="#D5E5D9" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="ListenPanel">
                                <Grid Height="209" Width="300" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse Width="295" Height="209">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#33533B" Offset="0" />
                                                <GradientStop Color="#203F31" Offset="0.44" />
                                                <GradientStop Color="#00203F31" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="188" Height="188" Stroke="#476953" StrokeThickness="1" StrokeDashArray="1,4" />
                                    <Ellipse Width="158" Height="158" Stroke="#3A5F4A" StrokeThickness="1" />
                                    <Ellipse Width="128" Height="128" Stroke="#557B60" StrokeThickness="1" Fill="#293F32" />
                                    <Ellipse Width="108" Height="108" Stroke="#669373" StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.9,1">
                                                <GradientStop Color="#42674C" Offset="0" />
                                                <GradientStop Color="#274335" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Path x:Name="Waveform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource Accent}"
                                          StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 0,29 V 37 M 10,23 V 43 M 20,17 V 49 M 30,9 V 57 M 40,0 V 66 M 50,12 V 54 M 60,21 V 45 M 70,25 V 41 M 80,29 V 37">
                                        <Path.LayoutTransform><ScaleTransform ScaleX="0.83" ScaleY="0.83" /></Path.LayoutTransform>
                                    </Path>
                                </Grid>
                                <TextBlock Text="What’s playing?" FontWeight="Bold" FontSize="35" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="Find the song playing in a YouTube video, Instagram Reel, or local MP4." FontSize="14" TextAlignment="Center"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="360" Margin="4,7,4,19" />
                            </StackPanel>

                            <StackPanel x:Name="TrackPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,18,0,20">
                                <Border Width="111" Height="111" CornerRadius="15" Background="#2C4636" HorizontalAlignment="Center">
                                    <Grid>
                                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource Accent}"
                                              StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 12,34 V 8 L 36,2 V 28 M 12,31 C 6,26 -3,34 2,38 C 6,41 12,38 12,34 M 36,25 C 30,20 21,28 26,32 C 30,35 36,32 36,28" />
                                        <Border x:Name="CoverArt" CornerRadius="14" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TrackTitle" FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,0" />
                                <TextBlock x:Name="TrackArtist" FontSize="17" Foreground="#D8E6DB" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock x:Name="TrackAlbum" FontSize="13" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button x:Name="SpotifyButton" Content="Search Spotify" Style="{StaticResource ButtonBase}" Margin="3,3" Click="OpenTrackLinkClick" />
                                    <Button x:Name="AppleMusicButton" Content="Apple Music" Style="{StaticResource ButtonBase}" Margin="3,3" Click="OpenTrackLinkClick" />
                                    <Button x:Name="SongLinkButton" Content="Open in Shazam" Style="{StaticResource ButtonBase}" Margin="3,3" Click="OpenTrackLinkClick" />
                                </WrapPanel>
                            </StackPanel>

                            <Button x:Name="FindButton" Height="49" Width="237" Content="Find song" HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}" FontSize="17" Click="FindClick" />
                            <StackPanel x:Name="ShortcutRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                        AutomationProperties.Name="Global shortcut Control Alt M">
                                <TextBlock Text="Shortcut" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" /></Border>
                                <TextBlock Text="+" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Alt" /></Border>
                                <TextBlock Text="+" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="M" /></Border>
                            </StackPanel>
                            <TextBlock x:Name="ShortcutWarning" Text="Ctrl + Alt + M is already in use by another app."
                                       Visibility="Collapsed" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,0" />
                            <ProgressBar x:Name="RecognitionProgress" Visibility="Collapsed" Width="237" Height="3" Maximum="100"
                                         Margin="0,12,0,0" Foreground="{StaticResource Accent}" Background="#27382E" BorderThickness="0" />
                            <TextBlock x:Name="Feedback" Visibility="Collapsed" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"
                                       FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="385" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13"
                            Margin="0,12,0,0" Padding="15,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="9" Background="#24392D" Margin="0,0,11,0" VerticalAlignment="Center">
                                <Path Data="M 9,1 L 1,11 H 8 L 7,19 L 16,8 H 9 Z" Stroke="{StaticResource Accent}" StrokeThickness="1.45"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Instant capture" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="BufferDescription" Text="Turn on to keep the last 10 seconds in memory." FontSize="12"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="CaptureToggle" Grid.Column="2" Style="{StaticResource Switch}" Click="CaptureToggleClick"
                                          VerticalAlignment="Center" AutomationProperties.Name="Instant capture" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Each search sends an audio fingerprint to Shazam." Foreground="{StaticResource Muted}"
                               FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="6,13,6,0" />
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
